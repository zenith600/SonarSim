# MANIFEST.in — controls which extra files are included in the source distribution (sdist)
# .py files are included automatically; this file handles everything else.

include README.md
include LICENSE
include pyproject.toml
include requirements.txt

# Documentation text files
include PHYSICS_EXPLANATION.txt
include COORDINATE_SYSTEM.txt

# HTML visualizers bundled with the package
recursive-include acousticsim *.html
recursive-include acousticsim *.txt

# Exclude generated build artifacts, caches, and test data
exclude *.bat
exclude simulation_results.json
exclude visualization_data.json
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * *.egg-info
prune dist/
prune build/
prune .eggs/
